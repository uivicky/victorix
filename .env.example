# =============================================================================
# VICTORIX 3.0 ENVIRONMENT CONFIGURATION (ZERO-COST / FREE-TIER ORIENTED)
# =============================================================================

# GEMINI_API_KEY: Optional Google Gemini AI API key (gemini-4-hydrogen).
# Free tier available at Google AI Studio. Deterministic fallback works without it.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ADMIN_PASSPHRASE: Secret passphrase for VICTORIX 3.0 Workspace login.
# REQUIRED on server/Vercel (never exposed in client source or UI).
ADMIN_PASSPHRASE="CHANGE_ME_ADMIN_PASSPHRASE"

# ADMIN_SESSION_SECRET: Strong random secret used to HMAC-SHA256 sign stateless HttpOnly session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="CHANGE_ME_STRONG_RANDOM_SESSION_SECRET"

# CRON_SECRET: Bearer / header authorization secret for 15-minute automation runs.
# Configure identically in GitHub Repository Secrets (CRON_SECRET) or Cloudflare Worker secrets.
CRON_SECRET="CHANGE_ME_CRON_SECRET"

# CLOUDFLARE D1 & KV (FREE TIER PERSISTENT PRIVATE STORAGE)
# Client-facing static websites do NOT use D1 or any database.
# Leave empty during local dev to use local persistence with clear SETUP REQUIRED status.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_API_TOKEN=""

# SCHEDULER MODE (Run ONLY one active scheduler at a time to prevent duplicate runs)
# Options: github_actions | cloudflare_worker | local_server
ACTIVE_SCHEDULER="github_actions"

# GOOGLE SEARCH CONSOLE & ANALYTICS 4 (Optional Free Tools)
# When omitted, the SEO Growth Monitor explicitly displays NOT CONNECTED.
GOOGLE_SEARCH_CONSOLE_KEY=""
GA4_MEASUREMENT_ID=""
PAGESPEED_API_KEY=""

# PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL="https://victorixglobal.vercel.app"
APP_URL="https://victorixglobal.vercel.app"
