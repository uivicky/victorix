{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/[...route]?__vercel_path=/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/[...route]?__vercel_path=/robots.txt"
    },
    {
      "src": "/api",
      "dest": "/api/[...route]?__vercel_path=/api/health"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...route]?__vercel_path=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
